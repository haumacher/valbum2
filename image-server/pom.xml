<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>de.haumacher</groupId>
		<artifactId>valbum2</artifactId>
		<version>2.2.0-SNAPSHOT</version>
	</parent>

	<artifactId>image-server</artifactId>

	<properties>
		<jetty.version>11.0.18</jetty.version>

		<!--
			The name of the executable JAR with all dependencies. The 'platform-jar' profile below
			appends the JavaCPP platform, if the build was restricted to a single platform.
		-->
		<assembly.finalName>${project.artifactId}</assembly.finalName>

		<!-- The Flutter web build to bundle into the server JAR, if it exists. -->
		<webapp.dir>${project.basedir}/../valbum_ui/build/web</webapp.dir>

		<!-- Where the filtered Debian control files are assembled, see the 'platform-jar' profile. -->
		<deb.controlDir>${project.build.directory}/deb/control</deb.controlDir>
	</properties>

	<profiles>
		<!--
			When the build is restricted to a single JavaCPP platform (-Djavacpp.platform=linux-x86_64),
			the resulting JAR contains the native libraries of that platform only and is named
			accordingly.
		-->
		<profile>
			<id>platform-jar</id>
			<activation>
				<property>
					<name>javacpp.platform</name>
				</property>
			</activation>
			<properties>
				<assembly.finalName>${project.artifactId}-${javacpp.platform}</assembly.finalName>
			</properties>

			<build>
				<plugins>
					<!--
						An unknown JavaCPP platform must fail the build rather than produce a .deb
						labelled with the wrong architecture. Each supported platform has a profile
						below setting 'deb.arch'; if none matched, the property is unset here.
					-->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-enforcer-plugin</artifactId>
						<executions>
							<execution>
								<id>enforce-deb-arch</id>
								<phase>validate</phase>
								<goals>
									<goal>enforce</goal>
								</goals>
								<configuration>
									<rules>
										<requireProperty>
											<property>deb.arch</property>
											<regex>^(amd64|arm64|armhf)$</regex>
											<message>Cannot build the Debian package: the JavaCPP platform '${javacpp.platform}' has no Debian architecture. Supported are -Djavacpp.platform=linux-x86_64 (amd64), linux-arm64 (arm64) and linux-armhf (armhf).</message>
											<regexMessage>Cannot build the Debian package: the JavaCPP platform '${javacpp.platform}' has no Debian architecture. Supported are -Djavacpp.platform=linux-x86_64 (amd64), linux-arm64 (arm64) and linux-armhf (armhf).</regexMessage>
										</requireProperty>
									</rules>
								</configuration>
							</execution>
						</executions>
					</plugin>

					<!--
						The Debian version of the Maven version: '1.1.0-SNAPSHOT' becomes
						'1.1.0~SNAPSHOT', because dpkg sorts '~' before the release it precedes.
						A release build (mvn versions:set from the tag) has a plain semver and is
						left alone.
					-->
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>build-helper-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>deb-version</id>
								<phase>validate</phase>
								<goals>
									<goal>regex-property</goal>
								</goals>
								<configuration>
									<name>deb.version</name>
									<value>${project.version}</value>
									<regex>-SNAPSHOT$</regex>
									<replacement>~SNAPSHOT</replacement>
									<failIfNoMatch>false</failIfNoMatch>
								</configuration>
							</execution>
						</executions>
					</plugin>

					<!-- The control file carries the version and the architecture. -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<executions>
							<execution>
								<id>deb-control</id>
								<phase>prepare-package</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${deb.controlDir}</outputDirectory>
									<resources>
										<resource>
											<directory>${project.basedir}/src/deb/control</directory>
											<includes>
												<include>control</include>
											</includes>
											<filtering>true</filtering>
										</resource>
										<resource>
											<directory>${project.basedir}/src/deb/control</directory>
											<excludes>
												<exclude>control</exclude>
											</excludes>
											<filtering>false</filtering>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>

					<!--
						Builds target/valbum_<version>_<arch>.deb from the platform JAR and the
						sources in src/deb. Only in this profile: an unrestricted build carries
						every platform's native libraries (about 2.3 GB) and has no architecture
						to label a package with.
					-->
					<plugin>
						<groupId>org.vafer</groupId>
						<artifactId>jdeb</artifactId>
						<executions>
							<execution>
								<id>deb</id>
								<phase>package</phase>
								<goals>
									<goal>jdeb</goal>
								</goals>
								<configuration>
									<deb>${project.build.directory}/valbum_${deb.version}_${deb.arch}.deb</deb>
									<controlDir>${deb.controlDir}</controlDir>
									<snapshotExpand>false</snapshotExpand>
									<skipPOMs>false</skipPOMs>
									<verbose>false</verbose>
									<dataSet>
										<data>
											<src>${project.build.directory}/${assembly.finalName}-jar-with-dependencies.jar</src>
											<type>file</type>
											<dst>/usr/share/valbum/valbum.jar</dst>
											<mapper>
												<type>perm</type>
												<filemode>644</filemode>
												<user>root</user>
												<group>root</group>
											</mapper>
										</data>
										<data>
											<src>${project.basedir}/src/deb/valbum-server</src>
											<type>file</type>
											<dst>/usr/bin/valbum-server</dst>
											<mapper>
												<type>perm</type>
												<filemode>755</filemode>
												<user>root</user>
												<group>root</group>
											</mapper>
										</data>
										<data>
											<src>${project.basedir}/src/deb/valbum.default</src>
											<type>file</type>
											<dst>/etc/default/valbum</dst>
											<mapper>
												<type>perm</type>
												<filemode>644</filemode>
												<user>root</user>
												<group>root</group>
											</mapper>
										</data>
										<data>
											<src>${project.basedir}/src/deb/valbum.service</src>
											<type>file</type>
											<dst>/lib/systemd/system/valbum.service</dst>
											<mapper>
												<type>perm</type>
												<filemode>644</filemode>
												<user>root</user>
												<group>root</group>
											</mapper>
										</data>
										<!--
											The default library folder. Shipped root-owned, because the
											'valbum' user is created by postinst, which hands the folder
											over afterwards. It is never removed, not even on purge.
										-->
										<data>
											<type>template</type>
											<paths>
												<path>/var/lib/valbum</path>
											</paths>
											<mapper>
												<type>perm</type>
												<dirmode>750</dirmode>
												<user>root</user>
												<group>root</group>
											</mapper>
										</data>
									</dataSet>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
			The Debian architecture of the JavaCPP platform the build is restricted to. A
			platform without a profile here leaves 'deb.arch' unset, which the enforcer rule
			above turns into a build failure naming the supported platforms.
		-->
		<profile>
			<id>deb-amd64</id>
			<activation>
				<property>
					<name>javacpp.platform</name>
					<value>linux-x86_64</value>
				</property>
			</activation>
			<properties>
				<deb.arch>amd64</deb.arch>
			</properties>
		</profile>
		<profile>
			<id>deb-arm64</id>
			<activation>
				<property>
					<name>javacpp.platform</name>
					<value>linux-arm64</value>
				</property>
			</activation>
			<properties>
				<deb.arch>arm64</deb.arch>
			</properties>
		</profile>
		<profile>
			<id>deb-armhf</id>
			<activation>
				<property>
					<name>javacpp.platform</name>
					<value>linux-armhf</value>
				</property>
			</activation>
			<properties>
				<deb.arch>armhf</deb.arch>
			</properties>
		</profile>
	</profiles>

	<dependencies>
		<dependency>
			<groupId>de.haumacher</groupId>
			<artifactId>image-server-shared</artifactId>
		</dependency>

		<dependency>
			<groupId>de.haumacher</groupId>
			<artifactId>util-servlet</artifactId>
		</dependency>

		<dependency>
			<groupId>net.sourceforge.argparse4j</groupId>
			<artifactId>argparse4j</artifactId>
			<version>0.9.0</version>
		</dependency>

		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
			<version>32.0.0-jre</version>
		</dependency>

		<dependency>
			<groupId>com.drewnoakes</groupId>
			<artifactId>metadata-extractor</artifactId>
			<version>2.18.0</version>
		</dependency>

		<dependency>
		    <groupId>org.apache.commons</groupId>
		    <artifactId>commons-fileupload2-jakarta</artifactId>
		    <version>2.0.0-M1</version>
		</dependency>

		<dependency>
		    <groupId>jakarta.activation</groupId>
		    <artifactId>jakarta.activation-api</artifactId>
		    <version>2.1.2</version>
		</dependency>

		<dependency>
			<groupId>org.eclipse.jetty</groupId>
			<artifactId>jetty-servlet</artifactId>
			<version>${jetty.version}</version>
		</dependency>

		<dependency>
			<groupId>org.eclipse.jetty</groupId>
			<artifactId>jetty-webapp</artifactId>
			<version>${jetty.version}</version>
		</dependency>

		<dependency>
			<groupId>org.bytedeco</groupId>
			<artifactId>javacv-platform</artifactId>
			<version>1.5.8</version>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>${project.artifactId}</finalName>
		<plugins>
			<!--
				Bundle the Flutter web build (if it was built) into the server JAR, so that the
				server can host the web application at its context root. A missing directory is not
				an error: a server JAR without the web application is a valid API-only deployment.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>

				<executions>
					<execution>
						<id>bundle-webapp</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}/META-INF/resources</outputDirectory>
							<resources>
								<resource>
									<directory>${webapp.dir}</directory>
									<filtering>false</filtering>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>3.1.1</version>

				<executions>
					<execution>
						<id>make-assembly</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<archive>
								<compress>false</compress>
								<manifest>
									<mainClass>de.haumacher.imageServer.Main</mainClass>
								</manifest>
							</archive>
							<descriptorRefs>
								<descriptorRef>jar-with-dependencies</descriptorRef>
							</descriptorRefs>
							<finalName>${assembly.finalName}</finalName>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.2.0</version>
				<configuration>
					<archive>
						<manifest>
							<addClasspath>true</addClasspath>
							<classpathPrefix>lib/</classpathPrefix>
							<mainClass>de.haumacher.imageServer.Main</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			
			
			<!-- To start the (test) server use: -->
			<!-- mvn exec:java@test-server -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.0.0</version>
				
				<executions>
					<execution>
						<id>start-server</id>
						
						<goals>
							<goal>java</goal>
						</goals>
					</execution>
				</executions>

				<configuration>
					<mainClass>de.haumacher.imageServer.Main</mainClass>
					
					<arguments>
						<argument>--port</argument>
						<argument>9090</argument>
						<argument>--contextpath</argument>
						<argument>valbum</argument>
						<argument>--basepath</argument>
						<argument>${project.basedir}/src/test/fixtures/test-album</argument>
						<argument>--pairing-secret</argument>
						<argument>demo</argument>
					</arguments>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
