#!/bin/bash
#
# Starts the VAlbum container image on a scratch copy of the test album and checks what the image
# promises (#174): the app base, an album, the seat code in the log, a video rendition made inside
# the container (which proves the FFmpeg libraries), the face index loaded and detecting the
# fixture portraits (which proves the OpenCV libraries), the health check, and that every file the
# server wrote into the mounted folder belongs to PUID:PGID; then valbum-admin moves that library
# into the space 'family' (#177), and the paired device lists the album at the old and the new
# address. A second container, started on an
# empty library as a new installation is, shows that valbum-admin runs a one-time job inside the
# running container (#180): the server is stopped, the first space created as PUID:PGID, and the
# server back with the new space's seat code in the log;
# and that 'docker stop' ends both containers through the forwarded SIGTERM, not a SIGKILL.
#
# Run by CI's Docker job and by the release before anything is pushed; usable by hand as well:
#
#   image-server/src/docker/smoke-test <image> [<platform>]      e.g. valbum:test linux/amd64
#
# Needs docker, curl and python3; runs from anywhere inside the repository. The committed fixture
# is never mounted: the container gets a copy in a temporary folder, removed afterwards.
#
set -euo pipefail

IMAGE=$1
PLATFORM=${2:-linux/amd64}
PORT=${SMOKE_PORT:-18174}
NAME=valbum-smoke-$$
ADMIN_NAME=$NAME-admin
ADMIN_PORT=$((PORT + 1))
ROOT=$(cd "$(dirname "$0")/../../.." && pwd)
FIXTURES=$ROOT/image-server/src/test/fixtures
WORK=$(mktemp -d)
LIBRARY=$WORK/library
BASE=http://127.0.0.1:$PORT/valbum
DATA=$BASE/data
ALBUM="2005-08-24%20Blumen%20und%20Fliegen"
PORTRAITS="2020-01-01%20Portraits"

cleanup() {
	status=$?
	if [ "$status" != 0 ]; then
		echo "--- container log"
		docker logs "$NAME" 2>&1 | tail -60 || true
	fi
	docker rm -f "$NAME" "$ADMIN_NAME" >/dev/null 2>&1 || true
	# Whatever the container wrote belongs to the caller, so this needs no root.
	rm -rf "$WORK"
	exit "$status"
}
trap cleanup EXIT

fail() {
	echo "smoke-test: FAILED: $*" >&2
	exit 1
}

# Polls a command until it succeeds, at most $1 seconds.
wait_for() {
	limit=$1
	shift
	start=$(date +%s)
	until "$@"; do
		if [ $(($(date +%s) - start)) -ge "$limit" ]; then
			return 1
		fi
		sleep 3
	done
}

# The test album without the state and the caches a developer's run left in it, plus a space
# with the face index on and the four fixture portraits as an album.
cp -r "$FIXTURES/test-album" "$LIBRARY"
rm -rf "$LIBRARY/.valbum"
find "$LIBRARY" -name .vacache -type d -prune -exec sh -c 'find "$1" -mindepth 1 ! -name .gitignore -delete' _ {} \;
mkdir -p "$LIBRARY/.valbum" "$LIBRARY/2020-01-01 Portraits"
echo '{"version": 1, "faces": "on"}' > "$LIBRARY/.valbum/space.json"
cp "$FIXTURES"/faces/*.jpg "$LIBRARY/2020-01-01 Portraits/"
touch "$WORK/started"

echo "smoke-test: starting $IMAGE ($PLATFORM) as $(id -u):$(id -g) on port $PORT"
docker run -d --name "$NAME" --platform "$PLATFORM" -p "127.0.0.1:$PORT:8080" \
	-e PUID="$(id -u)" -e PGID="$(id -g)" -v "$LIBRARY:/photos" "$IMAGE" >/dev/null

healthy() {
	state=$(docker inspect --format '{{.State.Status}} {{.State.Health.Status}}' "$NAME")
	case "$state" in
		"running healthy") return 0 ;;
		running*) return 1 ;;
		*) fail "the container is '$state'" ;;
	esac
}
wait_for 300 healthy || fail "the container did not become healthy within 300 s"
echo "smoke-test: healthy"

page=$(curl -fsS "$BASE/")
grep -q '<base href="/valbum/">' <<<"$page" || fail "the app base has no <base href=\"/valbum/\">"
echo "smoke-test: app base answers with <base href=\"/valbum/\">"

curl -fsS "$DATA/$ALBUM/?type=json" | grep -q '"AlbumInfo"' || fail "the album answers no AlbumInfo"
echo "smoke-test: album JSON answers"

code=$(docker logs "$NAME" 2>&1 | sed -n 's/.*sign the administrator in with the code \([A-Z0-9-]*\).*/\1/p' | tail -1)
[ -n "$code" ] || fail "the log carries no seat code"
echo "smoke-test: the log carries the seat code"

rendition() {
	status=$(curl -s -o /dev/null -w '%{http_code}' "$DATA/$ALBUM/MVI_0450.mp4?type=video")
	case "$status" in
		200) return 0 ;;
		202) return 1 ;;
		*) fail "the video rendition answers $status" ;;
	esac
}
wait_for 300 rendition || fail "no video rendition within 300 s"
echo "smoke-test: video rendition made inside the container"

curl -fsS "$DATA/?type=auth" | grep -q '"faces":true' || fail "?type=auth does not answer faces: true for a space with faces: on"
token=$(curl -fsS -X POST -H 'Content-Type: application/json' "$DATA/?action=pair" \
	--data "{\"deviceCode\": \"$code\", \"userName\": \"smoke\", \"deviceName\": \"smoke-test\"}" \
	| python3 -c 'import json, sys; print(json.load(sys.stdin)["token"])')
faces() {
	curl -fsS -H "Authorization: Bearer $token" "$DATA/$PORTRAITS/?type=json" | python3 -c '
import json, sys
album = json.load(sys.stdin)[1]
found = sum(1 for part in album["parts"] if part[1].get("faces"))
sys.exit(0 if not album.get("facesPending") and found == 4 else 1)'
}
wait_for 300 faces || fail "the face index did not find a face in each of the four portraits within 300 s"
echo "smoke-test: faces detected in all four portraits"

foreign=$(find "$LIBRARY" -newer "$WORK/started" \( ! -user "$(id -u)" -o ! -group "$(id -g)" \) | head -5)
[ -z "$foreign" ] || fail "files not owned by $(id -u):$(id -g): $foreign"
echo "smoke-test: all $(find "$LIBRARY" -newer "$WORK/started" | wc -l) files written belong to $(id -u):$(id -g)"

# --- valbum-admin move-into-space (#177): the library with a signed-in device becomes a space ------
# The paired device keeps its stored <context>/data, which the old address answers as the space.
if ! docker exec "$NAME" valbum-admin move-into-space family >"$WORK/move.out" 2>&1; then
	cat "$WORK/move.out"
	fail "'valbum-admin move-into-space' failed"
fi
sed 's/^/smoke-test:   /' "$WORK/move.out"
[ -f "$LIBRARY/family/.valbum/space.json" ] || fail "move-into-space left no family/.valbum/space.json"
[ -f "$LIBRARY/.valbum/moved.json" ] || fail "move-into-space wrote no .valbum/moved.json"
[ -d "$LIBRARY/family/2005-08-24 Blumen und Fliegen" ] || fail "the album was not moved into family/"
moved_back() {
	[ "$(docker logs "$NAME" 2>&1 | grep -c '^Image server started')" -ge 2 ] \
		&& curl -fsS -H "Authorization: Bearer $token" "$DATA/$ALBUM/?type=json" 2>/dev/null | grep -q '"AlbumInfo"'
}
wait_for 120 moved_back || fail "after move-into-space the old <context>/data does not list the album for the paired device"
echo "smoke-test: the server came back, and the paired device's old <context>/data lists the album"
curl -fsS -H "Authorization: Bearer $token" "$BASE/family/data/$ALBUM/?type=json" | grep -q '"AlbumInfo"' \
	|| fail "the new address <context>/family/data does not list the album"
curl -fsS "$BASE/" | grep -q '<base href="/valbum/">' || fail "the old app base does not answer after the move"
echo "smoke-test: the new address <context>/family/data lists the album too"

# 'docker stop' sends SIGTERM to the entry point, which forwards it to the server: the container
# ends with the server's own status (143), long before Docker's SIGKILL (137) after 10 s.
stops_cleanly() {
	start=$(date +%s)
	docker stop -t 10 "$1" >/dev/null
	took=$(($(date +%s) - start))
	exit_code=$(docker inspect --format '{{.State.ExitCode}}' "$1")
	[ "$exit_code" != 137 ] || fail "'docker stop' had to kill $2 (exit code 137)"
	[ "$took" -lt 9 ] || fail "'docker stop' took $took s for $2"
	echo "smoke-test: 'docker stop' ended $2 in $took s (exit code $exit_code)"
}

# --- valbum-admin in a running container (#180): the first space of a fresh installation ------
# Started once on an empty folder, the library holds the unclaimed administrator seat, which is no
# content: create-space makes the first space, and the server comes back serving it.
SPACES=$WORK/spaces
mkdir -p "$SPACES"
docker run -d --name "$ADMIN_NAME" --platform "$PLATFORM" -p "127.0.0.1:$ADMIN_PORT:8080" \
	-e PUID="$(id -u)" -e PGID="$(id -g)" -v "$SPACES:/photos" "$IMAGE" >/dev/null
seat_codes() {
	docker logs "$ADMIN_NAME" 2>&1 | grep -c "$1: sign the administrator in with the code" || true
}
starts() {
	docker logs "$ADMIN_NAME" 2>&1 | grep -c "^Image server started" || true
}
first_start() { [ "$(seat_codes "This library")" -ge 1 ]; }
wait_for 120 first_start || fail "the second container did not start on the empty library"
[ -f "$SPACES/.valbum/users.json" ] || fail "the first start wrote no administrator seat"

help=$(docker exec "$ADMIN_NAME" valbum-admin help) || fail "'valbum-admin help' failed"
grep -q '^  create-space ' <<<"$help" || fail "'valbum-admin help' does not offer create-space"
echo "smoke-test: 'valbum-admin help' offers create-space"

if ! docker exec "$ADMIN_NAME" valbum-admin create-space family --name "The Family" >"$WORK/admin.out" 2>&1; then
	cat "$WORK/admin.out"
	fail "'valbum-admin create-space' failed"
fi
sed 's/^/smoke-test:   /' "$WORK/admin.out"
grep -q '"The Family"' "$SPACES/family/.valbum/space.json" || fail "create-space wrote no space.json naming 'The Family'"
[ "$(stat -c %u:%g "$SPACES/family/.valbum/space.json")" = "$(id -u):$(id -g)" ] \
	|| fail "the job did not run as $(id -u):$(id -g)"
echo "smoke-test: valbum-admin create-space wrote the space as $(id -u):$(id -g)"

family_seat() { [ "$(seat_codes "Space 'family'")" -ge 1 ]; }
wait_for 120 family_seat || fail "the server did not come back with a seat code for the new space"
[ "$(docker inspect --format '{{.State.Status}}' "$ADMIN_NAME")" = running ] || fail "the container stopped during the job"
[ "$(starts)" -ge 2 ] || fail "the server was not restarted (one start only in the log)"
family_page() {
	curl -fsS "http://127.0.0.1:$ADMIN_PORT/valbum/family/" 2>/dev/null | grep -q '<base href="/valbum/family/">'
}
wait_for 60 family_page || fail "the new space's app base does not answer"
echo "smoke-test: the server came back in the same container, serving the new space, its seat code in the log"

# A job that leaves the server stopped: the health check says healthy all the same.
docker exec "$ADMIN_NAME" valbum-admin create-space other --no-restart >/dev/null || fail "'create-space --no-restart' failed"
health=$(docker exec "$ADMIN_NAME" healthcheck) || fail "the health check fails while paused"
grep -q paused <<<"$health" || fail "the health check does not answer healthy while paused"
echo "smoke-test: the health check answers healthy while the server is stopped for a job"
stops_cleanly "$ADMIN_NAME" "the paused container"
stops_cleanly "$NAME" "the running server"

echo "smoke-test: $IMAGE ($PLATFORM) passed"
