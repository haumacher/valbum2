#!/bin/sh
#
# Checks inside the VAlbum container image that the bundled natives find every library they link
# (#174) - the image's counterpart of TestDebianPackageLibraries, which checks the Debian
# package's Recommends against the same artifacts. Run by the Dockerfile's 'check' target, which
# CI builds; the published image never carries the extracted natives this reads.
#
# What is checked is what the server loads, the same two shapes as the Debian test:
#
#   - FFmpeg (#74, #87): every ELF of org/bytedeco/ffmpeg/<platform>/, the program included,
#     resolved with LD_LIBRARY_PATH on the extracted libraries, as VideoRenditions.program hands
#     the child process;
#   - the face index (#124, #182): what FaceDetection loads - libopencv_java.so, whose closure
#     ldd resolves through the extracted OpenCV libraries, and the OpenBLAS preset beside it. Not
#     every ELF of the OpenCV artifact: highgui links GTK 2, and the face index loads it no longer
#     (#182). So this also fails as soon as anything the face index loads needs a GUI library
#     again (GTK, GDK, cairo, highgui) - the image installs none of them, on purpose.
#
# Usage: check-libraries <dir the natives were extracted to (org/bytedeco/...)>
#
set -eu

ROOT=$1/org/bytedeco
platform_dir() {
	for dir in "$ROOT/$1"/linux-*; do
		if [ -d "$dir" ]; then echo "$dir"; return; fi
	done
	echo "check-libraries: no natives of '$1' below $ROOT." >&2
	exit 1
}
FFMPEG=$(platform_dir ffmpeg)
OPENCV=$(platform_dir opencv)
OPENBLAS=$(platform_dir openblas)
JAVACPP=$(platform_dir javacpp)

failed=0
checked=0
check() {
	path=$1
	libs=$2
	if ! out=$(LD_LIBRARY_PATH=$libs ldd "$path" 2>&1); then
		echo "check-libraries: ldd cannot read $path: $out" >&2
		failed=1
		return
	fi
	checked=$((checked + 1))
	missing=$(echo "$out" | grep 'not found' || true)
	if [ -n "$missing" ]; then
		echo "check-libraries: $path needs a library the image does not carry:" >&2
		echo "$missing" >&2
		failed=1
	fi
}

is_elf() {
	[ "$(head -c 4 "$1" | tail -c 3)" = ELF ]
}

# What VideoRenditions.linkSonames does before the child process starts (#210): a library the
# artifact stores under its unversioned name (libva.so) is linked beside it under the soname the
# others ask for (libva.so.2). The soname is the one string of the file that is its own name plus
# a version - the image carries no readelf to read DT_SONAME the way the server does.
for file in "$FFMPEG"/lib*.so; do
	if [ -f "$file" ] && [ ! -L "$file" ] && is_elf "$file"; then
		name=$(basename "$file")
		soname=$(grep -ao "$name\.[0-9][0-9.]*" "$file" | head -n 1 || true)
		if [ -n "$soname" ] && [ ! -e "$FFMPEG/$soname" ]; then
			ln -s "$name" "$FFMPEG/$soname"
			echo "check-libraries: linked $soname -> $name, as the server does."
		fi
	fi
done

for file in "$FFMPEG"/*; do
	if [ -f "$file" ] && [ ! -L "$file" ] && is_elf "$file"; then
		chmod +x "$file"
		check "$file" "$FFMPEG:$JAVACPP"
	fi
done
for file in "$OPENCV/libopencv_java.so" "$OPENBLAS"/libjniopenblas.so; do
	if [ ! -f "$file" ]; then
		echo "check-libraries: $file, which the face index loads, is missing." >&2
		failed=1
		continue
	fi
	check "$file" "$OPENCV:$OPENBLAS:$JAVACPP"
	gui=$(LD_LIBRARY_PATH="$OPENCV:$OPENBLAS:$JAVACPP" ldd "$file" 2>&1 \
		| grep -E 'lib(gtk|gdk|cairo)|highgui' || true)
	if [ -n "$gui" ]; then
		echo "check-libraries: $file, which the face index loads, links a GUI library (#182):" >&2
		echo "$gui" >&2
		failed=1
	fi
done

if [ "$failed" != 0 ]; then
	echo "check-libraries: install what is missing in the Dockerfile's apt-get line, and name it in image-server/src/deb/control/control's Recommends as well." >&2
	exit 1
fi
echo "check-libraries: $(basename "$FFMPEG"): FFmpeg and OpenCV ($checked ELF files) resolve every library they link."
