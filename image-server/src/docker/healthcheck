#!/bin/sh
#
# The HEALTHCHECK of the VAlbum container image (#174): the app base answers. It is the page every
# browser loads first, served without signing in whatever VALBUM_AUTH says, so it tells a running
# server from a hung or a crashed one without a token.
#
# While valbum-admin runs a one-time job the server is stopped on purpose (see docker-entrypoint);
# the check then answers healthy, so that a long job never marks the container unhealthy - which
# is what a watchdog on the NAS would restart it for, killing the job.
#
set -eu
if [ -e "${VALBUM_RUN:-/run/valbum}/pause" ]; then
	echo "paused for a valbum-admin job"
	exit 0
fi
context=${VALBUM_CONTEXTPATH:-}
context=${context#/}
context=${context%/}
if [ -n "$context" ]; then
	context="$context/"
fi
exec curl --fail --silent --show-error --max-time 8 --output /dev/null "http://127.0.0.1:${VALBUM_PORT:-8080}/$context"
