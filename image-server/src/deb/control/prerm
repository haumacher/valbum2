#!/bin/sh
set -e

case "$1" in
	remove|deconfigure)
		if [ -d /run/systemd/system ]; then
			if command -v deb-systemd-invoke >/dev/null 2>&1; then
				deb-systemd-invoke stop valbum.service >/dev/null 2>&1 || true
			else
				systemctl stop valbum.service >/dev/null 2>&1 || true
			fi
		fi
		;;
	upgrade|failed-upgrade)
		# The new postinst restarts the service.
		;;
	*)
		echo "prerm called with unknown argument '$1'" >&2
		exit 1
		;;
esac

exit 0
