# Configuration of the VAlbum server (/etc/default/valbum).
#
# Sourced by /usr/bin/valbum-server and handed to the systemd unit
# valbum.service as its environment. After a change:
#
#     sudo systemctl restart valbum
#
# A variable set in the environment of valbum-server wins over this file, so
# 'VALBUM_PORT=9090 valbum-server' runs a second instance on another port with
# everything else configured here. A library folder that does not exist (a disk
# not yet mounted) is refused; under systemd the service retries until it does.

# The folder holding the albums. Everything below it is served; sidecar files
# with titles, captions, ordering and the user database are written beside the
# photos. The originals are never modified, moved or deleted.
#
# Point this at an external disk if that is where the photos live, for example
# VALBUM_BASEPATH=/media/photos - the package does not restrict where the
# library may be, but the "valbum" user must be able to read and write there.
VALBUM_BASEPATH=/var/lib/valbum

# The TCP port the server listens on.
VALBUM_PORT=8080

# The context path the album is served under. Empty means the server root, so
# the album is at http://<host>:<port>/ . Set it to e.g. "valbum" to serve at
# http://<host>:<port>/valbum/ - useful behind a reverse proxy.
VALBUM_CONTEXTPATH=

# What requires a device paired with this server:
#   off    - every request is served, nobody has to sign in
#   writes - anonymous reads are served, anonymous changes and uploads refused
#   all    - anonymous requests are refused altogether
VALBUM_AUTH=writes

# Whether the server hosts one space or several. A space is a library of its
# own, with its own albums, users and sign-in:
#   auto   - follow the folders: several spaces as soon as one folder directly
#            below VALBUM_BASEPATH is a space (carries .valbum/space.json, which
#            'valbum-admin create-space <folder>' writes), one otherwise
#   single - the library folder is the one space, whatever the folders say
#   multi  - every space is a folder below the library folder, reached at
#            http://<host>:<port>/<context>/<folder>/ ; the albums directly in
#            the library folder are not served
VALBUM_SPACES=auto

# The address the album is reached at from outside - through the reverse
# proxy, with the context path - for example https://photos.example.org/valbum .
# Where it is set, the addresses the server spells for others (the preview card
# of a share link posted in a messenger) are built from it; where it is not,
# from each request, which is right as long as the proxy passes the forwarded
# host on.
#
#   VALBUM_PUBLIC_URL=https://photos.example.org/valbum

# The mail account the server sends one kind of mail through: the 6-digit code
# with which a visitor of a personal share link proves an e-mail address. It
# sends nothing else - invitations go out through the sharer's own mail
# program. Without VALBUM_SMTP_HOST no code is offered anywhere, and an open
# personal link ("anyone with the link who says who they are") cannot be used.
#
# Use the mail server of your mail provider (the one your mail program sends
# through) with your account there: mail sent straight from a home connection
# lands in spam. VALBUM_SMTP_TLS is starttls (submission, port 587, the
# default) or tls (port 465); VALBUM_SMTP_PORT is only needed for another port,
# and VALBUM_SMTP_FROM only where the account name is no e-mail address. Put a
# password with special characters in single quotes. This file is readable by
# root and the group valbum only, because of the password.
#
#   VALBUM_SMTP_HOST=smtp.example.org
#   VALBUM_SMTP_PORT=587
#   VALBUM_SMTP_USER=album@example.org
#   VALBUM_SMTP_PASSWORD='secret'
#   VALBUM_SMTP_FROM=album@example.org
#   VALBUM_SMTP_TLS=starttls

# "Continue with Google": a visitor of a personal share link proves their
# e-mail address by signing in with Google (OpenID Connect) instead of typing a
# mailed code. Create an OAuth client of the type "Web application" in the
# Google Cloud console (APIs & Services > Credentials), with the authorized
# redirect URI
#
#     <VALBUM_PUBLIC_URL>/oidc/callback
#
# (the server prints it at start-up), and publish the consent screen out of
# "Testing", which admits 100 users at most; the scopes asked for (openid,
# email, profile) need no review. It needs VALBUM_PUBLIC_URL, a fixed public
# https address: without it nothing is offered, and the journal says so. The
# secret is why this file is readable by root and the group valbum only.
#
#   VALBUM_OIDC_GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
#   VALBUM_OIDC_GOOGLE_CLIENT_SECRET='GOCSPX-...'
#
# A further provider of OpenID Connect is further variables of its own id, with
# the address of its discovery document and the name its button shows:
#
#   VALBUM_OIDC_CLUB_CLIENT_ID=valbum
#   VALBUM_OIDC_CLUB_CLIENT_SECRET='...'
#   VALBUM_OIDC_CLUB_DISCOVERY_URL=https://login.example.org/.well-known/openid-configuration
#   VALBUM_OIDC_CLUB_LABEL="Our club"

# Further server arguments, appended to the ones above. The most useful one is
# a fixed sign-in code for the administrator of a space that nobody has signed
# into yet; without it the server makes a fresh one at every start and prints it
# to the journal (journalctl -u valbum). The code is eight characters of
# ABCDEFGHJKLMNPQRSTUVWXYZ23456789, a dash between the groups allowed; it works
# once, lives ten minutes, and is issued again at every start until somebody
# signed in:
#
#   VALBUM_OPTS="--admin-code ABCD-EFGH"
#
# A web application built separately can be served from disk with
# --webroot /path/to/build/web (the one bundled into the package is used
# otherwise).
VALBUM_OPTS=

# Flags for the Java virtual machine. On a Raspberry Pi a heap limit keeps the
# server well inside the available memory, for example:
#
#   JAVA_OPTS="-Xmx512m"
JAVA_OPTS=

# The Java runtime to use. Leave empty to take "java" from the PATH, or the
# newest runtime below /usr/lib/jvm if there is none. VAlbum needs Java 21 or
# newer and refuses to start with anything older, naming what it found.
#
#   JAVA_HOME=/usr/lib/jvm/java-21-openjdk-arm64
JAVA_HOME=

# One-time jobs are run with valbum-admin, which stops the service, runs the
# job as the user "valbum" with the configuration above, and starts the
# service again. Adding a space, for instance, is:
#
#   sudo valbum-admin create-space family --name "The Family"
#
# and the journal then shows the sign-in code for the administrator of the new
# space (journalctl -u valbum). 'valbum-admin help' lists the jobs.
