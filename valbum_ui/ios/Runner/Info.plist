<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Valbum Ui</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>VAlbum uploads new photos from this device into your own album server.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>VAlbum uploads new photos from this device into your own album server.</string>
	<!-- Plain http:// to a self-hosted album server on the home network
	     (issue #73). The same reasoning as the Android network security
	     config: the server is reached by IP or by a local host name that no
	     exception domain can name at build time, and the Dart HTTP client of
	     this app already talks cleartext to it. Without this, AVPlayer - which
	     plays the videos - is refused where the album itself loads. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>VAlbum reads the device code shown on a device you are already signed in on, so that you do not have to type it.</string>
	<key>CFBundleName</key>
	<string>VAlbum</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Camera-roll sync while the app is closed (issue #32). The identifier
	     is the unique name the periodic task is registered under, see
	     `backgroundSyncTaskName` in `lib/background.dart`; the `workmanager`
	     plugin registers the BGTaskScheduler launch handler itself. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>de.haumacher.valbum.cameraRollSync</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
