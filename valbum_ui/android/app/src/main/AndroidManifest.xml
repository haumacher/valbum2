<manifest xmlns:android="http://schemas.android.com/apk/res/android">
   <!-- Camera-roll sync (issue #30) reads the device's photo library. -->
   <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
   <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
   <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
   <!-- Without it Android 10+ hands the app a copy of every photograph with its GPS tags zeroed
        (issue #166); with it photo_manager asks MediaStore for the original, position included. -->
   <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION"/>
   <!-- Reading a device code off another screen as a QR code (issue #66).
        No intent filter and no URL handler goes with it: the payload of such a
        code is not a link, see `lib/device_code_payload.dart`. -->
   <uses-permission android:name="android.permission.CAMERA"/>
   <!-- Uploading new photos with the screen off and the app closed (issue #300): the upload runs
        as a WorkManager foreground work of the type dataSync, which shows a notification while it
        runs. The workmanager plugin declares these too (dataSync through
        `workmanager.enableDataSyncForegroundService` in gradle.properties); they are named here
        because this app depends on them. POST_NOTIFICATIONS is asked at runtime (Android 13+)
        when the sync is switched on; without it the upload runs all the same, unseen. -->
   <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
   <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
   <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
   <!-- Plain http:// to a self-hosted server on the home network, which is
        what the native players need (issue #73); the reasoning is in the
        referenced file. -->
   <application
        android:label="VAlbum"
        android:name="${applicationName}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/va_logo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Opening a place of an album in the app (issue #275):
                 valbum://open?server=<app base>&path=<route>, see
                 `lib/deep_link.dart`. A scheme of its own, not App Links:
                 every server has its own domain. Flutter's deep linking hands
                 the link to the app as its initial route (cold start) and
                 through pushRouteInformation (warm start, singleTop). -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="valbum" android:host="open"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Sending a recipient their own personal share link through the sharer's own apps
         (issue #201): url_launcher opens mailto:, sms: and https://wa.me/ with ACTION_VIEW, and
         Android 11+ shows the app only the handlers it declared it looks for. The share sheet
         ("Other app…") is ACTION_SEND. No contacts permission is asked for anything. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="sms"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
